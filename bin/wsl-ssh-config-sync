#!/bin/sh
# The path unit starts it on every save of ~/.ssh/config.
set -eu

header='# Generated by wsl-ssh-config-sync from ~/.ssh/config in WSL. Do not edit: changes here are overwritten.'
target=${WSL_SSH_CONFIG_SYNC_TARGET:-}
if [ -z "$target" ]; then
  cat >&2 <<'EOF'
wsl-ssh-config-sync: WSL_SSH_CONFIG_SYNC_TARGET is not set.

Set it to the dedicated file the Windows OpenSSH config includes, for example:
  WSL_SSH_CONFIG_SYNC_TARGET=/mnt/c/Users/<you>/.ssh/wsl-synced-config

Write that line to the env file the service reads:
  ~/.config/wsl-ssh-config-sync/env
EOF
  exit 2
fi

src="$HOME/.ssh/config"

# Only a regular file starting with the header was generated here; anything else (the hand-edited Windows
# config, a symlink even if dangling, a FIFO) is left alone. The type check comes first so head never blocks.
if [ -L "$target" ] || { [ -e "$target" ] && { [ ! -f "$target" ] || [ "$(head -n 1 "$target")" != "$header" ]; }; }; then
  cat >&2 <<EOF
wsl-ssh-config-sync: $target is not a regular file generated by this tool; refusing to overwrite it.

Set WSL_SSH_CONFIG_SYNC_TARGET to the path of the dedicated file instead, for example:
  WSL_SSH_CONFIG_SYNC_TARGET=/mnt/c/Users/<you>/.ssh/wsl-synced-config
EOF
  exit 1
fi

# Write a fresh, uniquely named file beside the target and rename it, so a failed write never leaves
# a half-written file and no existing file (or symlink) is reused or removed.
tmp=$(mktemp "$target.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{ printf '%s\n' "$header"; cat "$src"; } > "$tmp"
mv "$tmp" "$target"
